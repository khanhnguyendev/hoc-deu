# Committed template — copy to .env.local for `pnpm dev` (never commit .env.local). Every
# other `.env*` file stays unread by contributors and agents (CLAUDE.md Safety).

# Local Supabase API URL (`pnpm exec supabase status -o env` once `pnpm db:start` is running).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# From `pnpm exec supabase status -o env` (PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site origin, no trailing slash (§2.5, decision 20).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# From `pnpm exec supabase status -o env` (SECRET_KEY) — server-only, never exposed to the client.
SUPABASE_SECRET_KEY=
# Comma-separated e-mails bootstrapped to admin on sign-in — only while no active admin exists,
# and only for a never-processed profile (decision 23, ruling R13). List only the owner's e-mail.
ADMIN_EMAILS=admin@example.test
# Enables the test-login route for e2e and local development — never in production (§2.3).
AUTH_TEST_LOGIN=true
# Maintenance cron secret (/api/cron/maintenance; Vercel cron sends `Authorization: Bearer
# <CRON_SECRET>`), >= 32 characters, e.g. `openssl rand -hex 32`. Required in production; empty
# here means unset, and the cron route then answers 401 to every request.
CRON_SECRET=

# Upstash rate limits (v1.1, §2.3, §2.5): optional — both or leave both empty, never one alone.
# Without them every rate limiter runs in memory (per instance), and `/admin` warns about it in
# production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot API (v1.1, §2.5, §6.2, ADR-0026): the kill switch's hard lock — only `true` turns it on, and
# `bot_settings.enabled` (the switch on /admin/bot) must be on too. Empty here means off: every
# /api/bot/v1 route answers 503. While it is `true`, BOT_REF_SECRET (the HMAC key of the per-run
# user refs, >= 32 characters, e.g. `openssl rand -base64 32`) is required. The bot token itself is
# never an env variable: it is created on /admin/bot.
BOT_API_ENABLED=
BOT_REF_SECRET=

# Optional local OAuth (supabase/config.toml): unset, the stack starts with empty credentials.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
