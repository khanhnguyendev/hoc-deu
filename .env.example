# Committed template — copy to .env.local for `pnpm dev` (never commit .env.local). Every
# other `.env*` file stays unread by contributors and agents (CLAUDE.md Safety).

# Local Supabase API URL (`pnpm exec supabase status -o env` once `pnpm db:start` is running).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# From `pnpm exec supabase status -o env` (PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site origin, no trailing slash (§2.5, decision 20).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# From `pnpm exec supabase status -o env` (SECRET_KEY) — server-only, never exposed to the client.
SUPABASE_SECRET_KEY=
# Comma-separated e-mails bootstrapped to admin on sign-in — only while no active admin exists,
# and only for a never-processed profile (decision 23, ruling R13). List only the owner's e-mail.
ADMIN_EMAILS=admin@example.test
# Enables the test-login route for e2e and local development — never in production (§2.3).
AUTH_TEST_LOGIN=true
# Cron route secret, >= 32 characters — optional until task 5.7.
# CRON_SECRET=

# Optional local OAuth (supabase/config.toml): unset, the stack starts with empty credentials.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
